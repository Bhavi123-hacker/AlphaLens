{
  "openapi": "3.1.0",
  "info": {
    "title": "AlphaLens research-only read API",
    "description": "P20 subset of generated AlphaLens OpenAPI, including explicit opt-in notification projection routes. Default API registers GET-only routes.",
    "version": "p17.api.v1"
  },
  "paths": {
    "/api/v1/alerts": {
      "get": {
        "tags": [
          "local notifications"
        ],
        "summary": "History",
        "operationId": "history_api_v1_alerts_get",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "DATA_SOURCE",
                    "PIPELINE",
                    "ML_RESEARCH",
                    "PORTFOLIO",
                    "PAPER_TRADING",
                    "STOCK_SIGNAL"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "name": "severity",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "INFO",
                    "WARNING",
                    "ERROR",
                    "CRITICAL"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Severity"
            }
          },
          {
            "name": "lifecycle",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "NEW",
                    "READ",
                    "ACKNOWLEDGED",
                    "RESOLVED"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Lifecycle"
            }
          },
          {
            "name": "delivery",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(NOT_REQUESTED|PENDING|DELIVERED|FAILED|RETRY_PENDING|SUPPRESSED)$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Delivery"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "default": "",
              "title": "Search"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10000,
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_JsonValue_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alerts/unread-count": {
      "get": {
        "tags": [
          "local notifications"
        ],
        "summary": "Unread",
        "operationId": "unread_api_v1_alerts_unread_count_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_JsonValue_"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alerts/preferences": {
      "get": {
        "tags": [
          "local notifications"
        ],
        "summary": "Preferences",
        "operationId": "preferences_api_v1_alerts_preferences_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_JsonValue_"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "local notifications"
        ],
        "summary": "Update Preferences",
        "operationId": "update_preferences_api_v1_alerts_preferences_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_JsonValue_"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alerts/{alert_id}": {
      "get": {
        "tags": [
          "local notifications"
        ],
        "summary": "Detail",
        "operationId": "detail_api_v1_alerts__alert_id__get",
        "parameters": [
          {
            "name": "alert_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "title": "Alert Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_JsonValue_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alerts/{alert_id}/state": {
      "post": {
        "tags": [
          "local notifications"
        ],
        "summary": "Update State",
        "operationId": "update_state_api_v1_alerts__alert_id__state_post",
        "parameters": [
          {
            "name": "alert_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "title": "Alert Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_JsonValue_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Classification": {
        "properties": {
          "data_reality": {
            "type": "string",
            "title": "Data Reality",
            "default": "REAL_MARKET_OBSERVATIONS"
          },
          "usage_classification": {
            "type": "string",
            "title": "Usage Classification",
            "default": "RESEARCH_ONLY"
          },
          "final_vintage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Vintage",
            "default": "FINAL_VINTAGE_RESEARCH_ASSUMPTION"
          },
          "research_profile": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Research Profile",
            "default": "RESEARCH_EOD_FINAL_VINTAGE_V1"
          },
          "p1_production_data_clearance": {
            "type": "string",
            "const": "OPEN",
            "title": "P1 Production Data Clearance",
            "default": "OPEN"
          },
          "production_market_data_use": {
            "type": "string",
            "const": "NOT_CLEARED",
            "title": "Production Market Data Use",
            "default": "NOT_CLEARED"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Classification"
      },
      "Envelope_JsonValue_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/JsonValue"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "as_of_session": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of Session"
          },
          "classification": {
            "$ref": "#/components/schemas/Classification"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "p17.api.v1"
          },
          "artifact_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Artifact Id"
          },
          "provenance": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object",
            "title": "Provenance"
          },
          "evidence_status": {
            "type": "string",
            "title": "Evidence Status",
            "default": "AVAILABLE"
          },
          "quality_status": {
            "type": "string",
            "title": "Quality Status",
            "default": "RESEARCH_ONLY_NOT_PRODUCTION_PIT"
          },
          "missing_data_reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Data Reasons",
            "default": []
          },
          "page": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Page"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data",
          "source"
        ],
        "title": "Envelope[JsonValue]"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JsonValue": {},
      "Page": {
        "properties": {
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More"
          },
          "total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "limit",
          "offset",
          "has_more"
        ],
        "title": "Page"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
